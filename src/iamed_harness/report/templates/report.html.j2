<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>iamed-harness :: {{ config.task_name }} :: {{ config.run_id }}</title>
<style>
  :root {
    --fundo: #050807;
    --painel: #0d1512;
    --borda: #1f2f29;
    --esmeralda: #10b981;
    --esmeralda-clara: #6ee7b7;
    --alerta: #f87171;
    --texto: #d1fae5;
    --texto-fraco: #7f9b91;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2.5rem 1.5rem 4rem;
    background: var(--fundo);
    color: var(--texto);
    font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
    font-size: 14px;
    line-height: 1.6;
  }
  main { max-width: 1000px; margin: 0 auto; }
  h1 { font-size: 1.5rem; margin: 0 0 .3rem; color: var(--esmeralda-clara); letter-spacing: .04em; }
  h2 {
    font-size: 1rem; margin: 2.6rem 0 .9rem; color: var(--esmeralda);
    text-transform: uppercase; letter-spacing: .12em;
    border-bottom: 1px solid var(--borda); padding-bottom: .45rem;
  }
  .sub { color: var(--texto-fraco); margin: 0 0 1.6rem; font-size: .82rem; }
  .grade { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .8rem; }
  .cartao {
    background: var(--painel); border: 1px solid var(--borda);
    border-radius: 8px; padding: .9rem 1rem;
  }
  .cartao .rotulo { color: var(--texto-fraco); font-size: .7rem; text-transform: uppercase; letter-spacing: .1em; }
  .cartao .valor { font-size: 1.6rem; color: var(--esmeralda-clara); margin-top: .2rem; }
  .cartao .nota { color: var(--texto-fraco); font-size: .74rem; }
  .cartao.risco .valor { color: var(--alerta); }
  table { width: 100%; border-collapse: collapse; margin-top: .4rem; font-size: .82rem; }
  th, td { text-align: left; padding: .45rem .6rem; border-bottom: 1px solid var(--borda); }
  th { color: var(--esmeralda); text-transform: uppercase; font-size: .68rem; letter-spacing: .08em; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr.vazio td { color: var(--texto-fraco); font-style: italic; }
  img { max-width: 100%; border: 1px solid var(--borda); border-radius: 8px; display: block; }
  .aviso {
    background: rgba(248, 113, 113, .08); border: 1px solid rgba(248, 113, 113, .35);
    border-left: 3px solid var(--alerta); border-radius: 6px;
    padding: .8rem 1rem; margin: 1rem 0; color: #fecaca; font-size: .82rem;
  }
  .ok {
    background: rgba(16, 185, 129, .07); border: 1px solid rgba(16, 185, 129, .3);
    border-left: 3px solid var(--esmeralda); border-radius: 6px;
    padding: .8rem 1rem; margin: 1rem 0; font-size: .82rem;
  }
  dl.config { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1.2rem; margin: 0; font-size: .8rem; }
  dl.config dt { color: var(--texto-fraco); }
  dl.config dd { margin: 0; word-break: break-all; }
  pre.bruto {
    background: #000; border: 1px solid var(--borda); border-radius: 6px;
    padding: .6rem .8rem; overflow-x: auto; font-size: .74rem; color: var(--texto-fraco);
    margin: .3rem 0 0; white-space: pre-wrap; word-break: break-word;
  }
  footer { margin-top: 3.5rem; color: var(--texto-fraco); font-size: .74rem; border-top: 1px solid var(--borda); padding-top: 1rem; }
</style>
</head>
<body>
<main>

  <h1>iamed-harness</h1>
  <p class="sub">{{ config.task_name }} &middot; {{ config.run_id }} &middot; gerado a partir de predictions.jsonl</p>

  <h2>Configuracao do run</h2>
  <dl class="config">
    <dt>provider</dt><dd>{{ config.provider }}</dd>
    <dt>modelo</dt><dd>{{ config.model }}</dd>
    <dt>temperatura</dt><dd>{{ config.temperature }}</dd>
    <dt>repeticoes</dt><dd>{{ config.repetitions }}</dd>
    <dt>limite</dt><dd>{{ config.limit if config.limit is not none else "sem limite" }}</dd>
    <dt>seed</dt><dd>{{ config.seed }}</dd>
    <dt>grader</dt><dd>{{ config.grader }}</dd>
    <dt>dataset</dt><dd>{{ config.dataset_path }} ({{ config.dataset_n_items }} itens)</dd>
    <dt>dataset sha256</dt><dd>{{ config.dataset_sha256 }}</dd>
    <dt>prompt</dt><dd>{{ config.prompt_path }}</dd>
    <dt>prompt sha256</dt><dd>{{ config.prompt_sha256 }}</dd>
    <dt>criado em</dt><dd>{{ config.created_at }}</dd>
  </dl>

  <h2>Acuracia</h2>
  <div class="grade">
    <div class="cartao">
      <div class="rotulo">acuracia</div>
      <div class="valor">{{ "%.1f"|format(r.accuracy.accuracy * 100) }}%</div>
      <div class="nota">IC 95%: {{ "%.1f"|format(r.accuracy.ci_low * 100) }}% a {{ "%.1f"|format(r.accuracy.ci_high * 100) }}%</div>
    </div>
    <div class="cartao">
      <div class="rotulo">acertos</div>
      <div class="valor">{{ r.accuracy.n_correct }}</div>
      <div class="nota">de {{ r.accuracy.n_total }} chamadas</div>
    </div>
    <div class="cartao {% if r.accuracy.n_failed > 0 %}risco{% endif %}">
      <div class="rotulo">falhas</div>
      <div class="valor">{{ r.accuracy.n_failed }}</div>
      <div class="nota">sem resposta utilizavel</div>
    </div>
    <div class="cartao">
      <div class="rotulo">acuracia se falhas sumissem</div>
      <div class="valor">{{ "%.1f"|format(r.accuracy.accuracy_parsed_only * 100) }}%</div>
      <div class="nota">numero inflado, exibido para contraste</div>
    </div>
  </div>

  {% if r.accuracy.n_failed > 0 %}
  <div class="aviso">
    <strong>{{ r.accuracy.n_failed }} chamada(s) sem resposta utilizavel.</strong>
    Elas continuam no denominador. Descarta-las elevaria a acuracia de
    {{ "%.1f"|format(r.accuracy.accuracy * 100) }}% para
    {{ "%.1f"|format(r.accuracy.accuracy_parsed_only * 100) }}% sem que o modelo tivesse acertado nada a mais.
  </div>
  {% else %}
  <div class="ok">Nenhuma chamada falhou: as duas acuracias coincidem.</div>
  {% endif %}

  {% if r.erros_por_tipo %}
  <table>
    <thead><tr><th>tipo de erro</th><th class="num">n</th></tr></thead>
    <tbody>
    {% for tipo, n in r.erros_por_tipo.items() %}
      <tr><td>{{ tipo }}</td><td class="num">{{ n }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <h2>Calibracao</h2>
  <div class="grade">
    <div class="cartao">
      <div class="rotulo">ECE uniforme</div>
      <div class="valor">{{ "%.3f"|format(r.calibration.ece_uniform) }}</div>
      <div class="nota">10 bins de largura fixa</div>
    </div>
    <div class="cartao">
      <div class="rotulo">ECE por quantil</div>
      <div class="valor">{{ "%.3f"|format(r.calibration.ece_quantile) }}</div>
      <div class="nota">{{ r.calibration.bins_quantile|length }} bins efetivos</div>
    </div>
    <div class="cartao">
      <div class="rotulo">MCE</div>
      <div class="valor">{{ "%.3f"|format(r.calibration.mce) }}</div>
      <div class="nota">pior bin nao vazio</div>
    </div>
    <div class="cartao">
      <div class="rotulo">Brier</div>
      <div class="valor">{{ "%.3f"|format(r.calibration.brier) }}</div>
      <div class="nota">{{ r.calibration.n_scored }} predicoes pontuadas</div>
    </div>
  </div>

  {% if r.calibration.n_sem_confianca > 0 %}
  <div class="aviso">
    {{ r.calibration.n_sem_confianca }} predicao(oes) sem confianca declarada ficaram fora do calculo de calibracao,
    porque nao ha confianca para comparar. Elas continuam contando na acuracia acima.
  </div>
  {% endif %}

  <img src="data:image/png;base64,{{ reliability_png }}" alt="Reliability diagram">

  <table>
    <thead>
      <tr>
        <th>bin</th><th class="num">n</th>
        <th class="num">confianca media</th><th class="num">acuracia media</th><th class="num">gap</th>
      </tr>
    </thead>
    <tbody>
    {% for b in r.calibration.bins_uniform %}
      <tr {% if b.n == 0 %}class="vazio"{% endif %}>
        <td>[{{ "%.1f"|format(b.lower) }}, {{ "%.1f"|format(b.upper) }}{{ "]" if loop.last else ")" }}</td>
        <td class="num">{{ b.n }}</td>
        <td class="num">{% if b.n %}{{ "%.3f"|format(b.mean_confidence) }}{% else %}vazio{% endif %}</td>
        <td class="num">{% if b.n %}{{ "%.3f"|format(b.mean_accuracy) }}{% else %}fora da media{% endif %}</td>
        <td class="num">{% if b.n %}{{ "%.3f"|format(b.mean_accuracy - b.mean_confidence) }}{% else %}-{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Variancia entre repeticoes</h2>
  {% if r.variance %}
    <div class="grade">
      <div class="cartao {% if r.variance.flip_rate > 0 %}risco{% endif %}">
        <div class="rotulo">flip rate</div>
        <div class="valor">{{ "%.1f"|format(r.variance.flip_rate * 100) }}%</div>
        <div class="nota">itens que mudaram de resposta</div>
      </div>
      <div class="cartao">
        <div class="rotulo">concordancia media</div>
        <div class="valor">{{ "%.1f"|format(r.variance.mean_agreement * 100) }}%</div>
        <div class="nota">fracao na resposta modal</div>
      </div>
      <div class="cartao">
        <div class="rotulo">desvio da acuracia</div>
        <div class="valor">{{ "%.3f"|format(r.variance.accuracy_std) }}</div>
        <div class="nota">entre {{ r.variance.repetitions }} execucoes identicas</div>
      </div>
      <div class="cartao">
        <div class="rotulo">itens instaveis</div>
        <div class="valor">{{ r.variance.itens_instaveis|length }}</div>
        <div class="nota">de {{ r.variance.n_items }} itens</div>
      </div>
    </div>
    {% if variance_png %}<img src="data:image/png;base64,{{ variance_png }}" alt="Curva de variancia">{% endif %}
    {% if r.variance.itens_instaveis %}
    <div class="aviso">
      Itens que mudaram de resposta entre execucoes identicas:
      {{ r.variance.itens_instaveis|join(", ") }}
    </div>
    {% endif %}
  {% else %}
    <p class="sub">Run com uma unica repeticao. Rode com <code>--repetitions 5</code> para medir variancia.</p>
  {% endif %}

  <h2>Quebra por subgrupo</h2>
  {% if r.subgroups %}
  <table>
    <thead>
      <tr><th>campo</th><th>valor</th><th class="num">n</th><th class="num">acertos</th><th class="num">falhas</th><th class="num">acuracia</th></tr>
    </thead>
    <tbody>
    {% for s in r.subgroups %}
      <tr>
        <td>{{ s.field }}</td><td>{{ s.value }}</td>
        <td class="num">{{ s.n }}</td><td class="num">{{ s.n_correct }}</td><td class="num">{{ s.n_failed }}</td>
        <td class="num">{{ "%.1f"|format(s.accuracy * 100) }}%</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="sub">Nenhum campo de subgrupo configurado nesta tarefa.</p>
  {% endif %}

  {% if comparacao %}
  <h2>Baseline versus perturbado</h2>
  <img src="data:image/png;base64,{{ comparison_png }}" alt="Comparacao entre runs">
  <table>
    <thead>
      <tr><th>metrica</th><th class="num">{{ comparacao.config.task_name }}</th><th class="num">{{ config.task_name }}</th><th class="num">delta</th></tr>
    </thead>
    <tbody>
      <tr>
        <td>acuracia</td>
        <td class="num">{{ "%.1f"|format(comparacao.accuracy.accuracy * 100) }}%</td>
        <td class="num">{{ "%.1f"|format(r.accuracy.accuracy * 100) }}%</td>
        <td class="num">{{ "%+.1f"|format((r.accuracy.accuracy - comparacao.accuracy.accuracy) * 100) }} pp</td>
      </tr>
      <tr>
        <td>ECE uniforme</td>
        <td class="num">{{ "%.3f"|format(comparacao.calibration.ece_uniform) }}</td>
        <td class="num">{{ "%.3f"|format(r.calibration.ece_uniform) }}</td>
        <td class="num">{{ "%+.3f"|format(r.calibration.ece_uniform - comparacao.calibration.ece_uniform) }}</td>
      </tr>
      <tr>
        <td>falhas</td>
        <td class="num">{{ comparacao.accuracy.n_failed }}</td>
        <td class="num">{{ r.accuracy.n_failed }}</td>
        <td class="num">{{ "%+d"|format(r.accuracy.n_failed - comparacao.accuracy.n_failed) }}</td>
      </tr>
    </tbody>
  </table>
  {% endif %}

  {% if falhas %}
  <h2>Amostra de falhas</h2>
  <p class="sub">Primeiras {{ falhas|length }} de {{ n_falhas }} chamadas sem resposta utilizavel.</p>
  <table>
    <thead><tr><th>item</th><th>rep</th><th>erro</th></tr></thead>
    <tbody>
    {% for p in falhas %}
      <tr>
        <td>{{ p.item_id }}</td>
        <td class="num">{{ p.repetition }}</td>
        <td>{{ p.error }}<pre class="bruto">{{ p.raw_response[:280] if p.raw_response else "(resposta vazia)" }}</pre></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <footer>
    iamed-harness &middot; {{ r.n_predictions }} predicoes brutas em runs/{{ config.run_id }}/predictions.jsonl &middot;
    reproduza com <code>harness report {{ config.run_id }}</code>
  </footer>

</main>
</body>
</html>
